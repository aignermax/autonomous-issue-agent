# GitHub Authentication
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Target Repositories
# Multi-repo mode: Use AGENT_REPOS for multiple repositories (comma-separated)
AGENT_REPOS=owner/repo1,owner/repo2,owner/repo3

# Single-repo mode: Use AGENT_REPO for a single repository (ignored if AGENT_REPOS is set)
# AGENT_REPO=aignermax/Connect-A-PIC-Pro

# Optional Configuration
AGENT_POLL_INTERVAL=15                 # Agent polling interval in seconds (default: 15)
DASHBOARD_REFRESH_INTERVAL=5           # Dashboard refresh interval in seconds (default: 5)
AGENT_ISSUE_LABEL=agent-task           # Activation label - issues must have this to be picked up (default: agent-task)
AGENT_COMPLEXITY_TAG=complex           # Complexity modifier - presence of this tag activates higher limits (default: complex)
AGENT_REPO_PATH=./repo                 # Local path for repository clone (default: ./repo)

# Resource limits based on complexity
# Regular tasks (agent-task only): Simple fixes, docs, small features
AGENT_MAX_TURNS_REGULAR=150            # Max turns for regular issues (default: 150)
AGENT_MAX_TOKENS_REGULAR=20000000      # Max tokens for regular issues: 20M (covers Worker+Reviewer+QA)

# Complex tasks (agent-task + complex tag): Full features, refactoring, architecture
AGENT_MAX_TURNS_COMPLEX=500            # Max turns for complex issues (default: 500)
AGENT_MAX_TOKENS_COMPLEX=50000000      # Max tokens for complex issues: 50M (3 agents × review/QA loops)

# Stacked PRs - PRs build on each other instead of all on main
# When enabled: PR #2 bases on branch from PR #1, PR #3 on PR #2, etc.
# When disabled: All PRs base on main (independent)
AGENT_ENABLE_STACKED_PRS=false         # Enable stacked PRs (default: false)

# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual tokens and configuration
# 3. Never commit .env to version control (already in .gitignore)

# ==============================
# WORKTREES & REVIEWER (multi-role agent)
# ==============================

# Base directory for per-issue git worktrees
AGENT_WORKTREE_DIR=~/.aia-worktrees

# Reviewer settings
# Worker → Reviewer iterations before escalation. Split by complexity so
# regular tasks don't pay for a second review pass when one usually suffices.
AGENT_MAX_REVIEW_ROUNDS_REGULAR=1      # Regular issues: trust QA to catch the worker's fix
AGENT_MAX_REVIEW_ROUNDS_COMPLEX=2      # Complex issues: re-verify after the worker addresses round-1 feedback
# AGENT_MAX_REVIEW_ROUNDS=2            # Legacy override — applies to both if set
AGENT_REVIEWER_MODEL=claude-sonnet-4-6 # Default reviewer model
AGENT_REVIEWER_MODEL_CRITICAL=claude-opus-4-7  # Used when issue has 'critical' label
AGENT_CRITICAL_LABEL=critical          # Label that triggers the higher-tier reviewer
AGENT_REVIEWER_MAX_TURNS=80            # Max turns for one review pass

# Eco mode: issues labeled "eco" run their coder sessions on a cheap
# Anthropic-compatible endpoint (default: Moonshot/Kimi K2). Reviewer/QA
# stay on the default provider. Without the key the tag is ignored.
AGENT_ECO_TAG=eco
AGENT_ECO_API_KEY=sk-your-moonshot-key
AGENT_ECO_MODEL=kimi-k2-thinking
AGENT_ECO_BASE_URL=https://api.moonshot.ai/anthropic

# Repo auto-discovery: ONE org-wide issue search per interval adds org repos
# with open agent-task issues to the effective repo list; they expire after
# N days without label activity. Empty org disables. Non-org repos stay
# manual via AGENT_REPOS.
AGENT_DISCOVERY_ORG=Akhetonics
AGENT_DISCOVERY_INTERVAL_SEC=120
AGENT_DISCOVERY_EXPIRY_DAYS=8

# OpenRouter: route specific repos

# OpenRouter: route specific repos coder sessions through OpenRouter Anthropic
# endpoint (cheap coding models; reviewer/QA stay on the default provider).
# Key inline OR from a file. Model examples: qwen/qwen3-coder,
# deepseek/deepseek-v3.2, z-ai/glm-4.6, moonshotai/kimi-k2
AGENT_OPENROUTER_REPOS=aignermax/Lunima
AGENT_OPENROUTER_KEY_FILE=/path/to/openrouter-key.txt
# AGENT_OPENROUTER_API_KEY=sk-or-v1-...
AGENT_OPENROUTER_MODEL=qwen/qwen3-coder
AGENT_OPENROUTER_BASE_URL=https://openrouter.ai/api

# complex issues auto-route the coder to the premium Claude model
# (hard work -> best model). Set false to make complex budget-only.
AGENT_COMPLEX_USES_CLAUDE=true
